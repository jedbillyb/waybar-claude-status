/* Claude Code status module — add to ~/.config/waybar/style.css */

#custom-claude {
    padding: 0 8px;
}

#custom-claude.none {
    /* no active sessions: render nothing */
    padding: 0;
    margin: 0;
}

#custom-claude.idle {
    color: #7f849c;   /* dim: waiting for your next prompt */
}

#custom-claude.working {
    color: #a6e3a1;   /* green: Claude is doing work */
}

#custom-claude.waiting {
    color: #f9e2af;   /* yellow: needs your attention / permission */
}
